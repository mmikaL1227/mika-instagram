# Instagram credentials
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password

# Optional: 2FA secret key (if 2FA is enabled)
INSTAGRAM_TOTP_SEED=

# Session file path (saves login session to avoid repeated logins)
SESSION_FILE=sessions/session.json

# -----------------------------------------------------------------------
# Email filtering (email_filter.py)
# -----------------------------------------------------------------------

# Your Namecheap email address and password (or app password)
EMAIL_ADDRESS=you@yourdomain.com
EMAIL_PASSWORD=your_email_password

# Namecheap IMAP settings (defaults shown — usually no need to change)
EMAIL_IMAP_HOST=mail.privateemail.com
EMAIL_IMAP_PORT=993
