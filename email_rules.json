{
  "_comment": "Rules are evaluated in order — first match wins. Emails that match no rule are ignored and not exported.",

  "default_category": "Ignored",
  "default_priority": "Low",

  "rules": [
    {
      "category": "WeTransfer",
      "priority": "High",
      "note": "Contains a WeTransfer download link — download the files",
      "match": {
        "sender_domains": ["wetransfer.com"],
        "subject_keywords": ["wetransfer", "we transfer", "shared a file", "sent you files"],
        "body_keywords": ["wetransfer.com", "we.tl/", "wetransfer link"]
      }
    },
    {
      "category": "Address",
      "priority": "High",
      "note": "Contains a physical address — print address sticker",
      "match": {
        "body_keywords": ["ship to", "shipping address", "delivery address", "send to", "mailing address", "postal address"],
        "regex": [
          "\\b\\d+\\s+\\w+(\\s+\\w+){0,3}\\s+(Street|St|Avenue|Ave|Road|Rd|Boulevard|Blvd|Drive|Dr|Lane|Ln|Way|Court|Ct|Place|Pl|Terrace|Ter|Circle|Cir|Highway|Hwy)\\.?\\b",
          "\\b[A-Z]{2}\\s+\\d{5}(-\\d{4})?\\b"
        ]
      }
    },
    {
      "category": "Unsure",
      "priority": "Medium",
      "note": "May contain an address or file — review manually",
      "match": {
        "body_keywords": [
          "address", "location", "zip code", "postcode", "po box",
          "download", "file attached", "transfer", "dropbox", "google drive",
          "onedrive", "share link", "shared with you", "click here to download"
        ],
        "subject_keywords": [
          "address", "location", "file", "download", "shared", "transfer", "link"
        ]
      }
    }
  ]
}
